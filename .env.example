# Copie este arquivo para ".env" e preencha. O ".env" não vai para o Git.

# Endereço do catálogo do fornecedor no Yupoo, sem barra no final.
# Fica aqui e não no código porque o repositório é público: de quem a Pulse
# compra é informação do negócio. Use com: npm run sync
YUPOO_BASE=

# Endereço do fornecedor de ROUPAS (camisas e bermudas), também sem barra no
# final e fora do Git pelo mesmo motivo. Use com: npm run sync-roupas
YUPOO_ROUPAS=

# URL pública das fotos. Vazio = usa a pasta public/img (desenvolvimento).
# Depois de subir as fotos para o Cloudflare R2, ponha aqui a URL pública do
# bucket — por exemplo https://pub-xxxxxxxx.r2.dev — e a mesma variável na Vercel.
VITE_IMAGE_BASE=

# Pasta onde "npm run images" grava as fotos (e de onde o upload lê).
# Vazio = public/img. Fora do projeto evita que o OneDrive sincronize GBs de fotos;
# o "npm run dev" serve essa pasta em /img.
IMG_DIR=

# Cloudflare R2 (só para "npm run upload-images")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pulse-catalogo
